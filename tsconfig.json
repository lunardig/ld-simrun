{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@lunardig/ld-interfaces": ["./vendor/ld-sdk/vendor/ld-interfaces/packages/ts/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
